# Text files are stored and checked out with LF (Unity, C#, Python and PowerShell are all fine with it).
* text=auto eol=lf

# Text formats used by the project
*.cs        text diff=csharp
*.ps1       text
*.py        text
*.json      text
*.md        text
*.csv       text
*.txt       text
*.bat       text eol=crlf
*.asmdef    text
*.meta      text
*.asset     text
*.prefab    text
*.unity     text
*.mat       text
*.controller text
*.anim      text

# Large binaries live in Git LFS (run `git lfs install` once per machine before cloning)
*.exe       filter=lfs diff=lfs merge=lfs -text
*.dll       filter=lfs diff=lfs merge=lfs -text
*.bnk       filter=lfs diff=lfs merge=lfs -text
*.wem       filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.obj       filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text
*.tga       filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/Assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text

# Small images (docs, README screenshots) stay in plain git so they render on the web
*.png       binary
*.jpg       binary
*.gif       binary
